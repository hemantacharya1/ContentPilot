# ===================================================================
#   Comprehensive .gitignore for Python/FastAPI & JS/Vite Monorepo
# ===================================================================

# === Environment Variables ===
# Ignore all .env files, but DO commit the example file for others.
.env*
!.env.example
!.env.ci

# === Python (FastAPI, Celery, etc.) ===
# Virtual environments
.venv/
venv/
env/

# Byte-compiled / optimized / C files
__pycache__/
*.py[cod]
*$py.class

# Build and distribution artifacts
build/
dist/
sdist/
eggs/
*.egg-info/
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# === Frontend (Node.js, Vite, React) ===
# Dependencies
node_modules/

# Vite specific cache
.vite/

# Build output
# The `dist` directory is already ignored above, which also covers Vite's build output.

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js & Storybook (Good to have for future-proofing)
.next/
out/
storybook-static/

# Monorepo tooling cache
.turbo/


# === AI / ML ===
# Ignore large model files and generated data
models/
*.ckpt
*.pth
*.h5
vector_store/
embeddings/


# === Infrastructure (Terraform) ===
# Ignore local Terraform state and configuration files
.terraform/
*.tfstate
*.tfstate.*
.terraformrc
terraform.rc
*.tfvars


# === IDE & Editor Config ===
# JetBrains IDEs (PyCharm, WebStorm, etc.)
.idea/

# VSCode
.vscode/

# Vim
*.swp
*.swo


# === OS Generated Files ===
# macOS
.DS_Store

# Windows
Thumbs.db


# === Other Generated Files ===
# Logs
*.log
*.log.*

# User-uploaded content
uploads/

# SQLite databases
*.sqlite3
*.db
db.sqlite3

# Temporary files
*.bak
*.tmp
*.temp